{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-agent.local/schemas/ui_preview_matrix.v1.schema.json",
  "$comment": "P1-G aggregation contract. It embeds the ui_preview_lineage.v2 record shape for completed cells; the P1-F schemas remain unchanged.",
  "title": "UI Preview Matrix v1",
  "description": "Verifiable aggregation of independent ui_preview revisions into one target-by-state matrix. Every expected cell is present exactly once, completed cells carry a complete ui_preview_lineage.v2 record and a fallback asset identity, and failed cells carry an error instead of a fabricated fallback or viewer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "matrix_id",
    "source_asset",
    "layout",
    "evidence_sha256",
    "target_matrix",
    "states",
    "entries",
    "coverage",
    "matrix_sha256"
  ],
  "properties": {
    "schema": {"const": "ui_preview_matrix.v1"},
    "matrix_id": {"$ref": "#/$defs/matrix_id"},
    "source_asset": {"$ref": "#/$defs/source_asset"},
    "layout": {"$ref": "#/$defs/layout"},
    "evidence_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "Evidence digest bound by the layout revision, or null when it records none."
    },
    "target_matrix": {"$ref": "#/$defs/target_matrix"},
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {"$ref": "#/$defs/entry"}
    },
    "coverage": {"$ref": "#/$defs/coverage"},
    "matrix_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256 over the RFC 8785 canonical JSON of this document without matrix_sha256."
    }
  },
  "$defs": {
    "matrix_id": {
      "type": "string",
      "pattern": "^matrix_[A-Za-z0-9._:-]{1,180}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target": {
      "type": "string",
      "enum": ["duo_folded", "duo_unfolded", "iphone_portrait", "iphone_landscape", "ipad_portrait", "ipad_landscape"]
    },
    "source_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset_[A-Za-z0-9._:-]{1,180}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "revision", "revision_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^layout_[A-Za-z0-9._-]{1,180}$"},
        "revision": {"type": "integer", "minimum": 1},
        "revision_sha256": {"$ref": "#/$defs/revision_sha256"}
      }
    },
    "target_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targets"],
      "properties": {
        "id": {"$ref": "#/$defs/matrix_id"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        }
      }
    },
    "fallback_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "mime_type", "width", "height", "sha256"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset_[A-Za-z0-9._:-]{1,180}$"},
        "mime_type": {"type": "string", "enum": ["image/png", "image/jpeg", "image/webp"]},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "entry_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "lineage_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"type": "string", "enum": ["user_confirmed", "not_required", "unconfirmed"]},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "user_confirmed"}}},
          "then": {"required": ["evidence_ref"]}
        }
      ]
    },
    "lineage_target_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targets"],
      "properties": {
        "id": {"$ref": "#/$defs/matrix_id"},
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/target"}
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "layout_artifact_id",
        "layout_revision",
        "layout_revision_sha256",
        "source_asset_id",
        "source_asset_sha256",
        "evidence_sha256",
        "approval",
        "target",
        "state",
        "target_matrix"
      ],
      "properties": {
        "schema": {"const": "ui_preview_lineage.v2"},
        "layout_artifact_id": {"type": "string", "pattern": "^layout_[A-Za-z0-9._:-]{1,180}$"},
        "layout_revision": {"type": "integer", "minimum": 1},
        "layout_revision_sha256": {"$ref": "#/$defs/revision_sha256"},
        "source_asset_id": {"type": "string", "pattern": "^asset_[A-Za-z0-9._:-]{1,180}$"},
        "source_asset_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval": {"$ref": "#/$defs/lineage_approval"},
        "target": {"$ref": "#/$defs/target"},
        "state": {"type": "string", "minLength": 1, "maxLength": 64},
        "target_matrix": {"$ref": "#/$defs/lineage_target_matrix"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "state",
        "status",
        "preview_artifact_id",
        "preview_revision",
        "preview_revision_sha256",
        "preview_mode",
        "lineage",
        "fallback_asset",
        "error"
      ],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "state": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"type": "string", "enum": ["completed", "failed", "missing"]},
        "preview_artifact_id": {
          "type": ["string", "null"],
          "pattern": "^preview_[A-Za-z0-9._:-]{1,180}$"
        },
        "preview_revision": {"type": ["integer", "null"], "minimum": 1},
        "preview_revision_sha256": {
          "anyOf": [{"$ref": "#/$defs/revision_sha256"}, {"type": "null"}]
        },
        "preview_mode": {
          "type": ["string", "null"],
          "enum": ["adaptation", "explore", null],
          "description": "Recorded preview class. A completed cell must be an adaptation preview; a failed cell may record the class of the revision that failed."
        },
        "lineage": {
          "anyOf": [{"$ref": "#/$defs/lineage"}, {"type": "null"}]
        },
        "fallback_asset": {
          "anyOf": [{"$ref": "#/$defs/fallback_asset"}, {"type": "null"}]
        },
        "error": {
          "anyOf": [{"$ref": "#/$defs/entry_error"}, {"type": "null"}]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "states", "expected", "completed", "failed", "missing", "complete"],
      "properties": {
        "targets": {"type": "integer", "minimum": 1},
        "states": {"type": "integer", "minimum": 1},
        "expected": {"type": "integer", "minimum": 1},
        "completed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "complete": {"type": "boolean"}
      }
    }
  }
}
