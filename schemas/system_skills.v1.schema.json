{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeagent.dev/schemas/system_skills.v1.schema.json",
  "title": "CodeAgent system skill bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_version", "skills"],
  "properties": {
    "schema": { "const": "codeagent.system-skills.v1" },
    "bundle_version": { "type": "string", "minLength": 1 },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "destination", "sha256", "scope", "files"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source": { "type": "string", "minLength": 1 },
          "destination": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "scope": { "const": "system" },
          "version": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "references": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      }
    }
  }
}
