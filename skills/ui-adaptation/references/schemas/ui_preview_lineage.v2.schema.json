{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-agent.local/schemas/ui_preview_lineage.v2.schema.json",
  "$comment": "P1-F adaptation preview lineage. v1 remains frozen for existing consumers.",
  "title": "UI Preview Lineage v2",
  "description": "Traceability record linking one UI adaptation preview revision to the reviewed layout revision, source asset, evidence, target form factor, and UI state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "layout_artifact_id",
    "layout_revision",
    "layout_revision_sha256",
    "source_asset_id",
    "source_asset_sha256",
    "evidence_sha256",
    "approval",
    "target",
    "state",
    "target_matrix"
  ],
  "properties": {
    "schema": {"const": "ui_preview_lineage.v2"},
    "layout_artifact_id": {
      "type": "string",
      "pattern": "^layout_[A-Za-z0-9._:-]{1,180}$"
    },
    "layout_revision": {"type": "integer", "minimum": 1},
    "layout_revision_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_asset_id": {
      "type": "string",
      "pattern": "^asset_[A-Za-z0-9._:-]{1,180}$"
    },
    "source_asset_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$",
      "description": "Digest of the ui_evidence.v1 bytes bound by the layout revision, or null when the layout has no evidence."
    },
    "approval": {"$ref": "#/$defs/approval"},
    "target": {
      "type": "string",
      "enum": ["duo_folded", "duo_unfolded", "iphone_portrait", "iphone_landscape", "ipad_portrait", "ipad_landscape"],
      "description": "The single form factor this preview revision depicts. Must be one of target_matrix.targets and a target declared by the layout revision."
    },
    "state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "The UI state this preview revision depicts. Must be declared by the layout revision screen.states."
    },
    "target_matrix": {"$ref": "#/$defs/target_matrix"}
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"type": "string", "enum": ["user_confirmed", "not_required", "unconfirmed"]},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "user_confirmed"}}},
          "then": {"required": ["evidence_ref"]}
        }
      ]
    },
    "target_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targets"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^matrix_[A-Za-z0-9._:-]{1,180}$"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["duo_folded", "duo_unfolded", "iphone_portrait", "iphone_landscape", "ipad_portrait", "ipad_landscape"]
          }
        }
      }
    }
  }
}
